# For LOCAL testing only. Production runs from /opt/fcs on the Oracle host and
# reads /etc/fcs-trading-bot.env; see deploy/README.md.

# Trade-only key: enable Futures + Reading, leave Withdrawals OFF.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Keep true until you've reviewed several days of proposals. Dry-run reads live
# inputs but sends no order/leverage mutation and never records a proposal as a
# fill.
DRY_RUN=true

# Same D1 database the rest of this repo's scripts use.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
FCS_D1_DATABASE_ID=

# --- Everything below has a sane default in src/config.mjs — only set
# what you actually want to change from the defaults. ---

# MIN_POSITION_PCT=0.05
# MAX_POSITION_PCT=0.20
# MAX_TOTAL_EXPOSURE_PCT=0.50
# MIN_LEVERAGE=3
# MAX_LEVERAGE=20
# LEVERAGE_AGGRESSION_MULTIPLIER=1.15 # applied after authorization; MAX_LEVERAGE remains a hard cap
# EDGE_FULL_SIZE=0.35             # conservative edge at which the bot commits full size (engine's own bar is 0.18)
# ENTRY_OFFSET_MIN_PCT=5          # long below / short above the immutable signal reference
# ENTRY_OFFSET_MAX_PCT=10
# ENTRY_OFFSET_HIGH_CONFIDENCE_FLOOR_PCT=4
# ENTRY_OFFSET_MAX_CONFIDENCE_REDUCTION_PCT=1
# ENTRY_OFFSET_DAILY_MOVE_MIN_SAMPLES=30
# ENTRY_OFFSET_WRONG_CALL_MIN_SAMPLES=10
# MAX_SIGNAL_AGE_MINUTES=30
# MAX_SIGNAL_MARK_DEVIATION_PCT=3
# ENTRY_ORDER_MIN_MINUTES=15      # Binance GTD must remain more than ten minutes away
# ENTRY_ORDER_MAX_HOURS=24
# ENTRY_LOW_RANGE_POS=0.25
# ENTRY_HIGH_RANGE_POS=0.75
# MAX_RESEARCH_EXPOSURE_PCT=0.15  # separate, lower ceiling for confirmed-research positions
# RESEARCH_STOP_WIDENING=1.5      # multiple of a strategy's own measured worst trade to place its stop beyond
# TAKE_PROFIT_MFE_FRACTION=0.7    # fraction of the measured mean favorable excursion to target
# TIME_EXIT_PEAK_MULTIPLE=1.0     # multiple of the measured mean time-to-peak after which an open position is closed
# PATIENCE_ADVERSE_FIRST_BOUND=0.5
# REVERSAL_DAY_RANGE_LOW=0.15
# REVERSAL_DAY_RANGE_HIGH=0.85
# SHADOW_LEDGER=true              # record what the bot WOULD have opened while the engine withholds
# SHADOW_MAX_OPEN=40
# FEAR_GREED_EXTREME_LOW=15
# FEAR_GREED_EXTREME_HIGH=85
# EXTREME_AGGRESSION_BOOST=1.25
# STOP_LOSS_MARGIN_FRACTION=0.5
# COOLDOWN_MINUTES=60
# CIRCUIT_BREAKER_DRAWDOWN_PCT=0.15
# DAILY_LOSS_LIMIT_PCT=0.10
# MAX_FUNDING_RATE_ABS=0.001
