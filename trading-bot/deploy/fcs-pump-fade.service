[Unit]
Description=FrontierCapitalSignals — pump-fade SHADOW ledger (records would-be shorts, places no orders)
Documentation=https://github.com/chiduwa/frontiercapitalsignals/blob/main/signals-worker/docs/PUMP_FADE_EVIDENCE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=fcsbot
Group=fcsbot
WorkingDirectory=/opt/fcs/trading-bot
EnvironmentFile=/etc/fcs-trading-bot.env

# No futures runtime lock: this places no orders and must never queue the
# trading bot behind a 250-symbol kline scan. A live version would take it.
ExecStart=/usr/bin/node src/pump-fade.mjs

TimeoutStartSec=300

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fcs-pump-fade
