[Unit]
Description=Sync the read-only Binance account journal every 15 minutes
Documentation=https://github.com/chiduwa/frontiercapitalsignals/blob/main/account-journal/README.md

[Timer]
# Offset from the five-minute futures decision cycle. This is a separate
# reader and never stops, starts, or locks either trading bot.
# In UTC, not the host's local clock, so a daylight-saving change can never
# shift or double this schedule (test.mjs pins it).
OnCalendar=*:2/15 UTC
AccuracySec=30s
Persistent=true
Unit=fcs-account-journal.service

[Install]
WantedBy=timers.target
